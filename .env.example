# Supabase（未設定ならログインなしのデモモードで動き、記録はブラウザに保存されます）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI分析（サーバー側だけで使います。ブラウザには渡りません）
ANTHROPIC_API_KEY=
# 使うモデル（省略時は claude-opus-5-5）
# ANTHROPIC_MODEL=claude-opus-5-5

# デモモードを本番に公開したときにもAIを使えるようにする（通常は不要）
# ALLOW_DEMO_AI=true

# MCP（Claude からの接続）で「今日」を決めるタイムゾーン。Vercel は UTC で動くため（例: Asia/Tokyo, Europe/Budapest）
# APP_TIME_ZONE=Asia/Tokyo
